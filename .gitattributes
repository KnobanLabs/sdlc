# Auto detect text files and perform LF normalization
*        text=auto

# Always perform LF normalization on these files
*.css    text
*.go     text
*.html   text
*.java   text
*.js     text
*.json   text
*.md     text
*.py     text
*.sh     text
*.ts     text
*.txt    text
*.xml    text
*.yaml   text
*.yml    text

# Make sure that these Windows files always have CRLF line endings in checkout
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
*.sln    text eol=crlf

# Never perform LF normalization on these files
*.gif    binary
*.gpg    binary
*.ico    binary
*.jar    binary
*.jpg    binary
*.pdf    binary
*.png    binary
*.webp   binary
*.zip    binary

