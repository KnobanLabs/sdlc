# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.log

# editors: the shared settings in .vscode/ are committed, a person's own aren't
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# env files: commit an .env.example with placeholders, never the real one
.env*
!.env.example

# agents' local settings
.claude/settings.local.json

# the plugin's eval runs: reports and transcripts from your own account
plugins/sdlc/evals/results/

# Python, for the plugin's rule checks
__pycache__/
*.pyc
.venv/
